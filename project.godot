; Possession V1g — Fiat Tenebris
; Godot 4.x project file

config_version=5

[application]

config/name="Possession V1g"
config/description="Hotseat 2-player prototype of the Possession board game (V1g - Fiat Tenebris)."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
; Custom boot splash — assets/splash.png is the painted "Possession" image
; with the two demonic figures flanking the kneeling Pope. fullsize=true
; tells Godot to scale the image so it fills the longer axis of the
; viewport while preserving aspect, which on iPad lands the demons at
; their full visual prominence rather than a tiny native-pixel rectangle
; in the middle of a black screen. use_filter=true → bilinear smoothing
; on the upscale (1672 px source × ~1.6× on a 12.9" iPad Pro). bg_color
; matches the manifest background_color (#08040c) so the iOS PWA launch
; transition into the Godot splash is seamless ; the splash itself is
; bordered by near-black pixels so the join is invisible.
boot_splash/show_image=true
boot_splash/image="res://assets/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/bg_color=Color(0.031, 0.016, 0.047, 1)

[autoload]

I18n="*res://scripts/data/I18n.gd"
GameEnums="*res://scripts/core/GameEnums.gd"
DomainData="*res://scripts/data/DomainData.gd"
TransgressionData="*res://scripts/data/TransgressionData.gd"
LiturgicalResponseData="*res://scripts/data/LiturgicalResponseData.gd"
CardImages="*res://scripts/data/CardImages.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/handheld/orientation=1
; Stretch mode "disabled" : the root viewport always matches the actual
; window pixel size and CanvasItems render at their canvas-coord pixel
; sizes — no automatic linear scaling of UI by window size.
;
; This is what we want for a responsive game UI :
;
; - Buttons stay at their absolute pixel size across devices. A 22 pt
;   button reads as 22 pt on a phone, on a tablet AND on a 2.4K monitor.
;   No "buttons three times bigger on a 4K screen" effect, which is
;   what canvas_items mode produces since it linearly scales every
;   CanvasItem by (window / base).
;
; - Image visuals (board, fullscreen card art, liturgy banners) use
;   anchors and Containers to fill the available space, so a bigger
;   screen automatically shows a bigger card image — exactly what is
;   wanted there.
;
; - Rendering is crisp because the viewport is the window : labels
;   rasterise their fonts at the displayed pixel grid, vector buttons
;   draw their styleboxes at the displayed pixel grid, no bilinear
;   blit pass anywhere.
;
; canvas_items mode was used briefly but causes the opposite : it
; grows EVERY CanvasItem with the window, including buttons and dialog
; chrome, which we don't want. The user explicitly called this out as
; "I do NOT want everything scaled linearly with the screen, including
; buttons".
;
; The previous concern about "tout est downscaled" on a 2.4K screen
; (items at small absolute pixel size) was actually the desired
; behaviour and not a bug — what was broken back then was the *blur*,
; not the absolute size. Blur is fixed by the viewport-matches-window
; pipeline plus allow_hidpi below.
window/stretch/mode="disabled"
; Render at the device's physical pixel resolution rather than at CSS /
; logical pixel size. Required on HiDPI displays (iPad Retina, Windows
; scaling 150 %, recent phones 2-3×) so Godot draws into the actual
; device pixels rather than a half-density buffer the browser then
; upscales.
window/dpi/allow_hidpi=true

[input_devices]

; Without this disable, every touchscreen tap also fires a synthesised
; InputEventMouseButton, so any handler that listens to both branches
; (the fullscreen card flip, the liturgy banner click) processes one tap
; twice. The double-fire flips the card forward then back so the second
; tap visibly «runs the animation but stops on the same face». Order /
; timing of the touch-vs-mouse pair varies across browsers, so a
; per-handler dedupe by timestamp is not reliable enough — disabling
; the synthesis entirely is the only solution that holds on Safari iOS,
; Chrome on Windows tablet and the rest. Every gui_input handler in
; the project already supports both InputEventScreenTouch and
; InputEventMouseButton on its own, so cutting the emulation costs us
; nothing.
pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.04, 0.05, 0.1, 1)
; Snap 2D transforms and vertices to integer pixel positions. Mostly a
; no-op in stretch_mode=disabled where everything already renders at
; the displayed pixel grid, but harmless and protects against any
; transient sub-pixel placement coming from animations (card flip
; tween, panel slides) or zoom (the _zoom_layer scale during pinch).
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
