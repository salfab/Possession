; Possession V1g — Fiat Tenebris
; Godot 4.x project file

config_version=5

[application]

config/name="Possession V1g"
config/description="Hotseat 2-player prototype of the Possession board game (V1g - Fiat Tenebris)."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

I18n="*res://scripts/data/I18n.gd"
GameEnums="*res://scripts/core/GameEnums.gd"
DomainData="*res://scripts/data/DomainData.gd"
TransgressionData="*res://scripts/data/TransgressionData.gd"
LiturgicalResponseData="*res://scripts/data/LiturgicalResponseData.gd"
CardImages="*res://scripts/data/CardImages.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/handheld/orientation=1
; Stretch mode "canvas_items" : the root viewport matches the window pixel
; size, and every CanvasItem (Label, Button stylebox, TextureRect…) gets
; a 2D transform scaled by (window_size / base_size). Items grow with
; the window AND get rasterised at the larger pixel grid — labels stay
; sharp at any zoom because the font rasteriser sees the post-scale
; size, vector buttons stay sharp because the stylebox is redrawn at
; the final pixel count, only bitmap textures soften by their own
; source-vs-display ratio.
;
; "disabled" was attempted briefly but causes items to render at
; canvas-pixel sizes regardless of window size — on a 2.4K monitor the
; UI then looks tiny (the "downscaled" feel) even though the rendering
; is technically crisp. canvas_items keeps proportional scaling AND
; per-element pixel-perfect rasterisation.
;
; aspect=keep_height : compute the scale from the height ratio and keep
; the same horizontal scale, letterboxing left/right if the window is
; wider than the base aspect. This avoids the non-integer mismatch
; between horizontal and vertical scales that "expand" produces on
; ultra-wide ratios — which can land glyphs and 1-pixel borders on
; sub-pixel positions and read as soft.
;
; scale=1.0 : no extra multiplier on top of the window/base ratio. The
; previous scale=1.5 was a fractional multiplier on top of an already
; fractional ratio (window/base), stacking sub-pixel rounding errors
; that came across as overall mushiness even when nothing was actually
; bilinearly stretched.
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"
window/stretch/scale=1.0
; Render at the device's physical pixel resolution rather than at CSS /
; logical pixel size. Required on HiDPI displays (iPad Retina, Windows
; scaling 150 %, recent phones 2-3×) so Godot draws into the actual
; device pixels rather than a half-density buffer the browser then
; upscales.
window/dpi/allow_hidpi=true

[input_devices]

; Without this disable, every touchscreen tap also fires a synthesised
; InputEventMouseButton, so any handler that listens to both branches
; (the fullscreen card flip, the liturgy banner click) processes one tap
; twice. The double-fire flips the card forward then back so the second
; tap visibly «runs the animation but stops on the same face». Order /
; timing of the touch-vs-mouse pair varies across browsers, so a
; per-handler dedupe by timestamp is not reliable enough — disabling
; the synthesis entirely is the only solution that holds on Safari iOS,
; Chrome on Windows tablet and the rest. Every gui_input handler in
; the project already supports both InputEventScreenTouch and
; InputEventMouseButton on its own, so cutting the emulation costs us
; nothing.
pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.04, 0.05, 0.1, 1)
; Snap 2D transforms and vertices to integer pixel positions. Without
; this, with a non-integer canvas_items scale (window/base ratio that
; falls between 1.0 and 2.0 on most monitors), Godot draws CanvasItems
; at sub-pixel positions and the GPU's bilinear sampling smears
; 1-pixel borders / glyph edges across two adjacent pixels — the
; classic "everything looks slightly fuzzy" symptom. Forcing
; integer-pixel placement keeps stylebox borders, label baselines and
; banner outlines locked to whole pixels and removes the perceived
; softness on big screens at non-integer scales (2.4K, Windows
; scaling 125 / 150 %, 1.75× browser zoom, etc.).
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
